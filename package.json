{
  "name": "lossless-addon",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted lossless FLAC audio addon for BitChord with multi-provider streaming support.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivamsingh-07/lossless-addon.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/adapters/node.js",
    "dev": "tsx watch src/adapters/node.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run typecheck && npm test && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.160.1"
  }
}
